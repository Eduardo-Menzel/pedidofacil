@model Cliente
@{
    ViewData["Title"] = "Excluir cliente";
    var temPedidos = ViewData["TemPedidos"] is true;
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4"><i class="bi bi-trash text-danger"></i> Excluir cliente</h1>

                @if (temPedidos)
                {
                    <div class="alert alert-warning mt-3" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> @Mensagens.ClienteComPedidos
                    </div>
                }
                else
                {
                    <p class="mt-3 mb-1">@Mensagens.ConfirmarExclusao</p>
                }

                <dl class="row mt-3 mb-0">
                    <dt class="col-sm-4">Cliente</dt>
                    <dd class="col-sm-8">@Model.Nome</dd>
                    <dt class="col-sm-4">CNPJ/CPF</dt>
                    <dd class="col-sm-8">@Model.CnpjCpf</dd>
                </dl>

                <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2 justify-content-end">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    @if (!temPedidos)
                    {
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Excluir</button>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
