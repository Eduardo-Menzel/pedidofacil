@model Cliente
@{
    ViewData["Title"] = "Detalhes do cliente";
}
<h1 class="h3">@Model.Nome</h1>

<dl class="row mt-3">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CnpjCpf)</dt>
    <dd class="col-sm-9">@Model.CnpjCpf</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Email) ? "–" : Model.Email)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Telefone)</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Telefone) ? "–" : Model.Telefone)</dd>
    <dt class="col-sm-3">Cidade/UF</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.CidadeUf) ? "–" : Model.CidadeUf)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DataCadastro)</dt>
    <dd class="col-sm-9">@Model.DataCadastro.ToString("dd/MM/yyyy")</dd>
</dl>

<h2 class="h5 mt-4">Pedidos deste cliente</h2>
@if (!Model.Pedidos.Any())
{
    <p class="text-muted fst-italic">@Mensagens.NenhumPedido</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle bg-white border">
            <thead class="table-light">
                <tr><th>Nº</th><th>Data</th><th>Status</th><th class="text-end">Total</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model.Pedidos.OrderByDescending(p => p.Id))
                {
                    <tr>
                        <td>@pedido.Id</td>
                        <td>@pedido.DataPedido.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge @pedido.Status.CorEtiqueta()">@pedido.Status</span></td>
                        <td class="text-end">@pedido.CalcularTotal().ToString("C")</td>
                        <td class="text-end"><a asp-controller="Pedidos" asp-action="Details" asp-route-id="@pedido.Id">Abrir</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>
