@model RegistrarViewModel
@{
    ViewData["Title"] = "Criar conta";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 text-center mb-1">Criar conta</h1>
                <p class="text-center text-muted small mb-4">A senha deve ter pelo menos 6 caracteres</p>

                <form asp-action="Registrar" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label> *
                        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label"></label> *
                        <input asp-for="Senha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmarSenha" class="form-label"></label> *
                        <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Criar conta</button>
                </form>

                <p class="text-center mt-3 mb-0">
                    Já tem conta? <a asp-action="Entrar">Entrar</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
