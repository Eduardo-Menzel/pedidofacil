@model Produto
@{
    ViewData["Title"] = "Excluir produto";
    var emUso = ViewData["EmUso"] is true;
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4"><i class="bi bi-trash text-danger"></i> Excluir produto</h1>

                @if (emUso)
                {
                    <div class="alert alert-warning mt-3" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> @Mensagens.ProdutoEmUso
                    </div>
                }
                else
                {
                    <p class="mt-3 mb-1">@Mensagens.ConfirmarExclusao</p>
                }

                <dl class="row mt-3 mb-0">
                    <dt class="col-sm-4">Produto</dt>
                    <dd class="col-sm-8">@Model.CodigoDescricao</dd>
                    <dt class="col-sm-4">Preço</dt>
                    <dd class="col-sm-8">@Model.PrecoUnitario.ToString("C")</dd>
                </dl>

                <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2 justify-content-end">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    @if (emUso)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Marcar como inativo</a>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Excluir</button>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
