@model Produto
@{
    ViewData["Title"] = "Detalhes do produto";
}
<h1 class="h3">@Model.Descricao</h1>

<dl class="row mt-3">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Codigo)</dt>
    <dd class="col-sm-9">@Model.Codigo</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.PrecoUnitario)</dt>
    <dd class="col-sm-9">@Model.PrecoUnitario.ToString("C")</dd>
    <dt class="col-sm-3">Situação</dt>
    <dd class="col-sm-9">@(Model.Ativo ? "Ativo" : "Inativo")</dd>
</dl>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>
