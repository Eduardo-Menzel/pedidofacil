@model Produto
@{
    ViewData["Title"] = "Editar produto";
}
<h1 class="h3">Editar produto</h1>
<p class="text-muted small">Alterar o preço não muda os pedidos já registrados: cada item guarda o preço do dia da venda.</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <partial name="_Campos" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
