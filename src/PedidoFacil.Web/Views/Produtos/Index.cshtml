@model IEnumerable<Produto>
@{
    ViewData["Title"] = "Produtos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Produtos</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Novo produto</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted fst-italic">@Mensagens.NenhumProduto</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white border">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th class="text-end">Preço unitário</th>
                    <th>Situação</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in Model)
                {
                    <tr class="@(produto.Ativo ? "" : "text-muted")">
                        <td class="text-nowrap">@produto.Codigo</td>
                        <td>@produto.Descricao</td>
                        <td class="text-end text-nowrap">@produto.PrecoUnitario.ToString("C")</td>
                        <td>
                            @if (produto.Ativo)
                            {
                                <span class="badge text-bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inativo</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@produto.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i><span class="d-none d-xl-inline"> Editar</span></a>
                            <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes"><i class="bi bi-eye"></i><span class="d-none d-xl-inline"> Detalhes</span></a>
                            <a asp-action="Delete" asp-route-id="@produto.Id" class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i><span class="d-none d-xl-inline"> Excluir</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Mostrando @Model.Count() produto(s). Produtos inativos não aparecem para adicionar em pedidos.</p>
}
