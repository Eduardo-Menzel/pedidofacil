@model int
@{
    var naoEncontrada = Model == 404;
    ViewData["Title"] = naoEncontrada ? "Página não encontrada" : "Erro";
}
<div class="text-center py-5">
    <div class="display-1 fw-bold text-primary">@Model</div>
    <h1 class="h3 mt-3">@(naoEncontrada ? "Página não encontrada" : "Não foi possível concluir a solicitação")</h1>
    <p class="text-muted">@(naoEncontrada ? Mensagens.PaginaNaoEncontrada : Mensagens.ErroInesperado)</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar para o início</a>
</div>
